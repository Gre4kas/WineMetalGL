+/**********************************************************************
+ *              WineMetalGL core
+ *
+ * The whole OpenGL implementation lives in libwinemetalgl.dylib on Metal.
+ * It is the default; WINEMETALGL=0 selects Apple's OpenGL instead, and so
+ * does a missing or incompatible libwinemetalgl.dylib.
+ * No CGL context is created: winemac only hands the core a CAMetalLayer per
+ * window and forwards context, surface and swap operations. The interface
+ * is include/winemetalgl/driver.h in the WineMetalGL repository.
+ */
+
+#define WMGL_DRIVER_ABI_VERSION 1
+
+struct wmgl_pixel_format
+{
+    int draw_to_window, draw_to_pbuffer, double_buffer, stereo;
+    int color_bits, red_bits, green_bits, blue_bits, alpha_bits;
+    int red_shift, green_shift, blue_shift, alpha_shift;
+    int depth_bits, stencil_bits, accum_bits, aux_buffers;
+    int sample_buffers, samples, srgb_capable, float_components;
+    int max_pbuffer_width, max_pbuffer_height, max_pbuffer_pixels;
+};
+
+static void *wmgl_handle;
+static int (*p_wmgl_initialize)(unsigned int);
+static unsigned int (*p_wmgl_get_pixel_formats)(struct wmgl_pixel_format *, unsigned int, unsigned int *);
+static void *(*p_wmgl_surface_create_window)(void *, int, int, int);
+static void *(*p_wmgl_surface_create_pbuffer)(int, int, int);
+static void (*p_wmgl_surface_destroy)(void *);
+static void (*p_wmgl_surface_flush)(void *, unsigned int, int, int, int);
+static int (*p_wmgl_surface_swap)(void *);
+static void *(*p_wmgl_context_create)(int, void *, const int *, int *);
+static void (*p_wmgl_context_destroy)(void *);
+static int (*p_wmgl_make_current)(void *, void *, void *);
+static void *(*p_wmgl_get_proc_address)(const char *);
+static const char *(*p_wmgl_renderer_string)(void);
+static unsigned int (*p_wmgl_video_memory_mb)(void);
+static void (*p_wmgl_max_versions)(int *, int *, int *, int *);
+
+static struct wmgl_pixel_format *wmgl_formats;
+static unsigned int wmgl_format_count, wmgl_onscreen_count;
+
+struct wmgl_drawable
+{
+    struct opengl_drawable base;
+    void *surface;
+};
+
+static struct wmgl_drawable *wmgl_impl(struct opengl_drawable *base)
+{
+    return base ? CONTAINING_RECORD(base, struct wmgl_drawable, base) : NULL;
+}
+
+static BOOL wmgl_core_requested(void)
+{
+    const char *value = getenv("WINEMETALGL");
+    return !value || strcmp(value, "0");
+}
+
+static UINT wmgl_init_pixel_formats(UINT *onscreen)
+{
+    *onscreen = wmgl_onscreen_count;
+    return wmgl_format_count;
+}
+
+static BOOL wmgl_describe_pixel_format(int format, struct wgl_pixel_format *descr)
+{
+    const struct wmgl_pixel_format *f;
+
+    if (format <= 0 || format > (int)wmgl_format_count) return FALSE;
+    f = &wmgl_formats[format - 1];
+    memset(descr, 0, sizeof(*descr));
+    descr->pfd.nSize = sizeof(descr->pfd);
+    descr->pfd.nVersion = 1;
+    /* Fully accelerated: neither PFD_GENERIC_FORMAT nor PFD_GENERIC_ACCELERATED. */
+    descr->pfd.dwFlags = PFD_SUPPORT_OPENGL | PFD_SUPPORT_COMPOSITION;
+    if (f->draw_to_window) descr->pfd.dwFlags |= PFD_DRAW_TO_WINDOW;
+    if (f->double_buffer) descr->pfd.dwFlags |= PFD_DOUBLEBUFFER;
+    if (f->stereo) descr->pfd.dwFlags |= PFD_STEREO;
+    descr->pfd.iPixelType = PFD_TYPE_RGBA;
+    descr->pfd.cColorBits = f->color_bits;
+    descr->pfd.cRedBits = f->red_bits;
+    descr->pfd.cRedShift = f->red_shift;
+    descr->pfd.cGreenBits = f->green_bits;
+    descr->pfd.cGreenShift = f->green_shift;
+    descr->pfd.cBlueBits = f->blue_bits;
+    descr->pfd.cBlueShift = f->blue_shift;
+    descr->pfd.cAlphaBits = f->alpha_bits;
+    descr->pfd.cAlphaShift = f->alpha_shift;
+    descr->pfd.cAccumBits = f->accum_bits;
+    descr->pfd.cDepthBits = f->depth_bits;
+    descr->pfd.cStencilBits = f->stencil_bits;
+    descr->pfd.cAuxBuffers = f->aux_buffers;
+    descr->pfd.iLayerType = PFD_MAIN_PLANE;
+    descr->swap_method = WGL_SWAP_UNDEFINED_ARB;
+    descr->transparent = FALSE;
+    descr->pixel_type = f->float_components ? WGL_TYPE_RGBA_FLOAT_ARB : WGL_TYPE_RGBA_ARB;
+    descr->draw_to_pbuffer = f->draw_to_pbuffer;
+    descr->max_pbuffer_pixels = f->max_pbuffer_pixels;
+    descr->max_pbuffer_width = f->max_pbuffer_width;
+    descr->max_pbuffer_height = f->max_pbuffer_height;
+    descr->sample_buffers = f->sample_buffers;
+    descr->samples = f->samples;
+    descr->framebuffer_srgb_capable = f->srgb_capable;
+    descr->float_components = f->float_components;
+    return TRUE;
+}
+
+static void wmgl_init_extensions(struct opengl_funcs *funcs, BOOLEAN extensions[GL_EXTENSION_COUNT])
+{
+}
+
+static void wmgl_surface_destroy(struct opengl_drawable *base)
+{
+    struct wmgl_drawable *gl = wmgl_impl(base);
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+    if (gl->surface) p_wmgl_surface_destroy(gl->surface);
+    gl->surface = NULL;
+}
+
+static void wmgl_surface_flush(struct opengl_drawable *base, UINT flags)
+{
+    struct wmgl_drawable *gl = wmgl_impl(base);
+    TRACE("drawable %s, flags %#x\n", debugstr_opengl_drawable(base), flags);
+    if (!gl->surface) return;
+    p_wmgl_surface_flush(gl->surface, flags, base->monitor_size.cx, base->monitor_size.cy, base->interval);
+    if (flags & GL_FLUSH_PRESENT) client_surface_present(base->client);
+}
+
+static BOOL wmgl_surface_swap(struct opengl_drawable *base)
+{
+    struct wmgl_drawable *gl = wmgl_impl(base);
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+    if (!gl->surface) return FALSE;
+    /* A frame the core could not present (no drawable available) is
+     * dropped, as a compositor would; SwapBuffers itself succeeds. */
+    if (!p_wmgl_surface_swap(gl->surface)) TRACE("frame not presented\n");
+    client_surface_present(base->client);
+    return TRUE;
+}
+
+static const struct opengl_drawable_funcs wmgl_surface_funcs =
+{
+    .destroy = wmgl_surface_destroy,
+    .flush = wmgl_surface_flush,
+    .swap = wmgl_surface_swap,
+};
+
+static const struct opengl_drawable_funcs wmgl_pbuffer_funcs =
+{
+    .destroy = wmgl_surface_destroy,
+};
+
+static BOOL wmgl_surface_create(struct client_surface *client, int format, struct opengl_drawable **drawable)
+{
+    struct macdrv_client_surface *surface = impl_from_client_surface(client);
+    struct wmgl_drawable *gl;
+    macdrv_metal_layer layer;
+    RECT rect;
+
+    TRACE("client %s, format %d\n", debugstr_client_surface(client), format);
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface)) return FALSE;
+    if (!(layer = macdrv_swapchain_get_layer(surface->metal_swapchain))) return FALSE;
+    if (!NtUserGetClientRect(client->hwnd, &rect, NtUserGetWinMonitorDpi(client->hwnd, MDT_RAW_DPI)))
+        SetRectEmpty(&rect);
+    if (!(gl = opengl_drawable_create(sizeof(*gl), &wmgl_surface_funcs, format, client))) return FALSE;
+    gl->surface = p_wmgl_surface_create_window(layer, format, rect.right - rect.left, rect.bottom - rect.top);
+    if (!gl->surface)
+    {
+        opengl_drawable_release(&gl->base);
+        return FALSE;
+    }
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+static BOOL wmgl_pbuffer_create(HDC hdc, int format, BOOL largest, GLenum texture_format, GLenum texture_target,
+                                GLint max_level, GLsizei *width, GLsizei *height, struct opengl_drawable **drawable)
+{
+    struct wmgl_drawable *gl;
+
+    TRACE("hdc %p, format %d, %dx%d\n", hdc, format, *width, *height);
+    if (!(gl = opengl_drawable_create(sizeof(*gl), &wmgl_pbuffer_funcs, format, NULL))) return FALSE;
+    gl->surface = p_wmgl_surface_create_pbuffer(format, *width, *height);
+    if (!gl->surface)
+    {
+        opengl_drawable_release(&gl->base);
+        return FALSE;
+    }
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+/* win32u creates every client context without a share context and lets
+ * opengl32 handle wglShareLists, which needs all contexts in the process to
+ * share one object namespace (upstream Wine shares them all with its internal
+ * context). Every WineMetalGL context therefore shares with a hidden root
+ * context that lives for the rest of the process. */
+static void *wmgl_root_context;
+static pthread_mutex_t wmgl_root_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void *wmgl_share_root(int format)
+{
+    int error = 0;
+    pthread_mutex_lock(&wmgl_root_mutex);
+    if (!wmgl_root_context) wmgl_root_context = p_wmgl_context_create(format, NULL, NULL, &error);
+    pthread_mutex_unlock(&wmgl_root_mutex);
+    return wmgl_root_context;
+}
+
+static BOOL wmgl_context_create(int format, void *share, const int *attribs, void **private, BOOL *shared)
+{
+    int error = 0;
+    void *context;
+
+    TRACE("format %d, share %p, attribs %p\n", format, share, attribs);
+    if (!share && !(share = wmgl_share_root(format)))
+    {
+        RtlSetLastWin32Error(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(context = p_wmgl_context_create(format, share, attribs, &error)))
+    {
+        switch (error)
+        {
+        case 1: RtlSetLastWin32Error(ERROR_INVALID_VERSION_ARB); break;
+        case 2: RtlSetLastWin32Error(ERROR_INVALID_PROFILE_ARB); break;
+        default: RtlSetLastWin32Error(ERROR_INVALID_PARAMETER); break;
+        }
+        return FALSE;
+    }
+    *private = context;
+    *shared = TRUE;
+    return TRUE;
+}
+
+static BOOL wmgl_context_destroy(void *private)
+{
+    TRACE("context %p\n", private);
+    p_wmgl_context_destroy(private);
+    return TRUE;
+}
+
+static BOOL wmgl_make_current(struct opengl_drawable *draw, struct opengl_drawable *read, void *private)
+{
+    struct wmgl_drawable *d = wmgl_impl(draw), *r = wmgl_impl(read);
+    TRACE("draw %s, read %s, context %p\n", debugstr_opengl_drawable(draw), debugstr_opengl_drawable(read), private);
+    return p_wmgl_make_current(private, d ? d->surface : NULL, r ? r->surface : NULL);
+}
+
+static void *wmgl_driver_get_proc_address(const char *name)
+{
+    return p_wmgl_get_proc_address(name);
+}
+
+static BOOL wmgl_pbuffer_updated(HDC hdc, struct opengl_drawable *base, GLenum cube_face, GLint mipmap_level)
+{
+    return GL_TRUE;
+}
+
+static UINT wmgl_pbuffer_bind(HDC hdc, struct opengl_drawable *base, GLenum buffer)
+{
+    return -1; /* win32u copies the pbuffer into the bound texture */
+}
+
+static const struct opengl_driver_funcs wmgl_driver_funcs =
+{
+    .p_get_proc_address = wmgl_driver_get_proc_address,
+    .p_init_pixel_formats = wmgl_init_pixel_formats,
+    .p_describe_pixel_format = wmgl_describe_pixel_format,
+    .p_init_extensions = wmgl_init_extensions,
+    .p_surface_create = wmgl_surface_create,
+    .p_context_create = wmgl_context_create,
+    .p_context_destroy = wmgl_context_destroy,
+    .p_make_current = wmgl_make_current,
+    .p_pbuffer_create = wmgl_pbuffer_create,
+    .p_pbuffer_updated = wmgl_pbuffer_updated,
+    .p_pbuffer_bind = wmgl_pbuffer_bind,
+};
+
+static UINT wmgl_core_init(const struct opengl_driver_funcs **driver_funcs)
+{
+    if (!(wmgl_handle = dlopen("@loader_path/libwinemetalgl.dylib", RTLD_NOW | RTLD_LOCAL)))
+    {
+        WARN("libwinemetalgl.dylib failed to load, using Apple's OpenGL: %s\n", dlerror());
+        return STATUS_NOT_SUPPORTED;
+    }
+#define LOAD(name) if (!(p_##name = dlsym(wmgl_handle, #name))) { ERR("%s missing\n", #name); goto failed; }
+    LOAD(wmgl_initialize);
+    LOAD(wmgl_get_pixel_formats);
+    LOAD(wmgl_surface_create_window);
+    LOAD(wmgl_surface_create_pbuffer);
+    LOAD(wmgl_surface_destroy);
+    LOAD(wmgl_surface_flush);
+    LOAD(wmgl_surface_swap);
+    LOAD(wmgl_context_create);
+    LOAD(wmgl_context_destroy);
+    LOAD(wmgl_make_current);
+    LOAD(wmgl_get_proc_address);
+    LOAD(wmgl_renderer_string);
+    LOAD(wmgl_video_memory_mb);
+    LOAD(wmgl_max_versions);
+#undef LOAD
+    if (p_wmgl_initialize(WMGL_DRIVER_ABI_VERSION))
+    {
+        ERR("WineMetalGL core refused to initialize\n");
+        goto failed;
+    }
+    wmgl_format_count = p_wmgl_get_pixel_formats(NULL, 0, &wmgl_onscreen_count);
+    if (!wmgl_format_count || !(wmgl_formats = calloc(wmgl_format_count, sizeof(*wmgl_formats)))) goto failed;
+    p_wmgl_get_pixel_formats(wmgl_formats, wmgl_format_count, &wmgl_onscreen_count);
+    TRACE("WineMetalGL core: %u pixel formats (%u on screen), renderer %s\n", wmgl_format_count, wmgl_onscreen_count,
+          p_wmgl_renderer_string());
+    *driver_funcs = &wmgl_driver_funcs;
+    return STATUS_SUCCESS;
+
+failed:
+    dlclose(wmgl_handle);
+    wmgl_handle = NULL;
+    return STATUS_NOT_SUPPORTED;
+}
+
